# ── Neo4j Aura (or self-hosted) ───────────────────────────────────────────────
# Use neo4j+ssc:// on Railway/Windows to skip TLS cert verification.
NEO4J_URI=neo4j+ssc://xxxxxxxx.databases.neo4j.io
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=your-neo4j-password
NEO4J_DATABASE=neo4j

# ── Backend REST API ──────────────────────────────────────────────────────────
# URL of the deployed FastAPI backend (Railway service URL).
BACKEND_URL=https://your-backend.up.railway.app

# ── Admin credentials (fallback when no AdminUser node exists) ────────────────
ADMIN_USERNAME=admin
# Generate with: python -c "import bcrypt; print(bcrypt.hashpw(b'yourpassword', bcrypt.gensalt(12)).decode())"
ADMIN_PASSWORD_HASH=$2b$12$...

# ── Admin setup code (required to register the first admin account) ───────────
ADMIN_SETUP_CODE=haulistry-setup-2025

# ── Session ───────────────────────────────────────────────────────────────────
SESSION_TIMEOUT_MINUTES=120

# ── Firebase (optional — bcrypt fallback used when not set) ──────────────────
FIREBASE_WEB_API_KEY=AIzaSy...
# Also place your Firebase service-account JSON at the path below (not committed):
# FIREBASE_CREDENTIALS_PATH=./haulistry-firebase-adminsdk.json
