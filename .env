# Root environment placeholders (do not commit real secrets)

# Realtime host (Railway)
REALTIME_BASE_URL=https://<your-railway-service>.up.railway.app

# Backend Redis (Upstash TCP/TLS URL)
REDIS_URL=rediss://default:<UPSTASH_TOKEN>@<UPSTASH_HOST>:6379
REDIS_ENABLED=true

# Metered TURN
METERED_TURN_DOMAIN=haulistry.metered.live
METERED_API_KEY=<METERED_API_KEY>
TURN_REGION=global

# Socket.IO
SOCKETIO_CORS_ORIGINS=https://haulistry-app.vercel.app
SOCKETIO_PATH=socket.io
