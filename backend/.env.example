# Environment Configuration
# Copy this file to .env and fill in your values

# Neo4j Configuration
NEO4J_URI=neo4j+s://your-instance.databases.neo4j.io
NEO4J_USER=neo4j
NEO4J_PASSWORD=your_password_here
NEO4J_DATABASE=neo4j

# Firebase Configuration
# For local dev: path to your service-account JSON file
FIREBASE_CREDENTIALS_PATH=./serviceAccountKey.json

# For Vercel / serverless: base64-encoded service-account JSON
# Generate on Linux/macOS: base64 -w 0 your-service-account.json
# Generate on PowerShell:  [Convert]::ToBase64String([IO.File]::ReadAllBytes('file.json'))
FIREBASE_CREDENTIALS_JSON=

# Optional explicit bucket name (recommended for media upload reliability)
# Example: haulistry-1b835.appspot.com
FIREBASE_STORAGE_BUCKET=

# Optional project id override (used for fallback bucket inference)
FIREBASE_PROJECT_ID=

# Agora Configuration
AGORA_APP_ID=
AGORA_APP_CERTIFICATE=

# Application Configuration
SECRET_KEY=your_secret_key_here_generate_with_openssl
DEBUG=False  # Set to True for verbose logging with timestamps and debug info
HOST=0.0.0.0
PORT=4000
ENVIRONMENT=development

# CORS Origins (comma-separated)
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:8080

# Pricing Configuration
BASE_RATE_MULTIPLIER=1.0
DISTANCE_RATE_PER_KM=5.0
MINIMUM_CHARGE=100.0

# Storage Configuration
MAX_IMAGE_SIZE_MB=5
ALLOWED_IMAGE_EXTENSIONS=jpg,jpeg,png,webp
