# Miscellaneous
*.class
*.log
*.pyc
*.swp
.DS_Store
.atom/
.build/
.buildlog/
.history
.svn/
.swiftpm/
migrate_working_dir/

# IntelliJ related
*.iml
*.ipr
*.iws
.idea/

# The .vscode folder contains launch configuration and tasks you configure in
# VS Code which you may wish to be included in version control, so this line
# is commented out by default.
#.vscode/

# Flutter/Dart/Pub related
**/doc/api/
**/ios/Flutter/.last_build_id
.dart_tool/
.flutter-plugins-dependencies
.pub-cache/
.pub/
/build/
/coverage/

# Symbolication related
app.*.symbols

# Obfuscation related
app.*.map.json

# Android Studio will place build artifacts here
/android/app/debug
/android/app/profile
/android/app/release

# ── Sensitive / Secret Files ─────────────────────────────────
# Firebase config — contains API keys; use google-services.json.template instead
android/app/google-services.json
ios/Runner/GoogleService-Info.plist

# Environment files
.env
.env.local
.env.*.local

# Android signing secrets
android/key.properties
android/keystore/*.jks
android/keystore/*.keystore

# Firebase options (may contain embedded API keys — review before including)
# lib/firebase_options.dart  ← uncomment if generated with real keys

# Flutter plugin cache
.flutter-plugins
